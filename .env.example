# Copy this file to .env.local and fill in real values. Never commit .env.local.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side / local-admin only — never prefix with VITE_.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Braze credentials are stored in Supabase Vault (never in .env).
# Configure them per-client via the "Braze 설정" button in the app.
